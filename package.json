{
  "name": "@lyohaplotinka/nestjs-standalone-logger",
  "version": "0.1.0",
  "description": "NestJS logger extracted from the framework and decoupled from it. Works in any Node.js or Bun project with zero NestJS dependencies.",
  "keywords": [
    "console",
    "log-levels",
    "logger",
    "logging",
    "nestjs",
    "standalone"
  ],
  "bugs": {
    "url": "https://github.com/alexeysolovyov/nestjs-standalone-logger/issues"
  },
  "license": "MIT",
  "author": "lyohaplotinka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeysolovyov/nestjs-standalone-logger.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "example": "bun ./example.ts",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run build",
    "lint": "oxfmt && oxlint --fix"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
